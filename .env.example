# ==============================================================================
# ASINAN MEREM MELEK (AMM) — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Petunjuk: Salin file ini menjadi `.env.local` untuk development lokal, atau
# masukkan variabel di bawah ini ke panel deployment hosting produksi (Vercel, Railway, Coolify, VPS).
# JANGAN PERNAH menyertakan file berisi token/rahasia asli ke version control (git).

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_NAME="Asinan Merem Melek"
NEXT_PUBLIC_APP_URL="https://asinanmeremmelek.site"

# Kunci rahasia internal untuk enkripsi session cookie & verifikasi internal (minimal 32 karakter acak)
SESSION_SECRET="amm_prod_session_secret_change_this_to_strong_random_string_32_chars"
OTP_PEPPER_SECRET="amm_pepper_salt_for_cryptographic_otp_hashing_change_me_prod"

# ------------------------------------------------------------------------------
# 2. OTP / SMS / WHATSAPP PROVIDER
# ------------------------------------------------------------------------------
# Pilihan provider: "SIMULATED" | "FONNTE" | "TWILIO"
# Jika SIMULATED, kode OTP otomatis ditampilkan di log konsol dan banner helper untuk dev/testing.
SMS_PROVIDER=SIMULATED

# Konfigurasi Fonnte WhatsApp Gateway (https://fonnte.com)
FONNTE_TOKEN=your_fonnte_token_here

# Konfigurasi Twilio SMS (https://twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1234567890

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY INTEGRATION
# ------------------------------------------------------------------------------
# Pilihan gateway: "MANUAL_TRANSFER" | "MIDTRANS" | "XENDIT" | "TRIPAY"
# Default adalah MANUAL_TRANSFER (BCA, Mandiri, QRIS) dengan verifikasi bukti transfer.
PAYMENT_GATEWAY_PROVIDER=MANUAL_TRANSFER

# Konfigurasi Midtrans Snap & Core API (https://midtrans.com)
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_IS_PRODUCTION=false

# Konfigurasi Xendit Invoices (https://xendit.co)
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here
XENDIT_WEBHOOK_VERIFICATION_TOKEN=your_xendit_webhook_token_here

# Konfigurasi Tripay Payment Gateway (https://tripay.co.id)
TRIPAY_API_KEY=your_tripay_api_key_here
TRIPAY_PRIVATE_KEY=your_tripay_private_key_here
TRIPAY_MERCHANT_CODE=T12345
TRIPAY_IS_PRODUCTION=false

# Izinkan simulasi payment webhook untuk testing QA/Dev
ALLOW_PAYMENT_SIMULATION=false

# ------------------------------------------------------------------------------
# 4. DELIVERY & DISTANCE ROUTING (OSRM)
# ------------------------------------------------------------------------------
# Public / self-hosted OSRM driving routing engine URL
# Default fallback menggunakan public OSRM atau haversine factor
OSRM_BASE_URL=https://router.project-osrm.org

# ------------------------------------------------------------------------------
# 5. INITIAL SUPER ADMIN ACCOUNT (Optional Initializer)
# ------------------------------------------------------------------------------
ADMIN_INITIAL_USERNAME=superadmin
ADMIN_INITIAL_EMAIL=admin@asinanmeremmelek.site
ADMIN_INITIAL_PASSWORD=admin12345
